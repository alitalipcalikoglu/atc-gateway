# --- Listener ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind another proxy/CDN that sets X-Forwarded-For (rate limits key on the client IP).
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy or CDN terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Sent with every response when TLS is on; 0 disables. Default 1 year when TLS_CERT_PATH is set.
HSTS_MAX_AGE=
SERVER_NAME=atc-gateway

# --- Routing ---
ROUTES_FILE=./routes.json

# --- Defaults (routes may override rateLimit, bodyLimit, timeoutMs) ---
RATE_LIMIT_MAX=300
BODY_LIMIT=1048576
UPSTREAM_TIMEOUT_MS=30000
UPSTREAM_CONNECT_TIMEOUT_MS=5000
UPSTREAM_COOLDOWN_MS=10000
# Consecutive failures (closed state) before the circuit breaker opens. 1 = any single failure opens it.
UPSTREAM_BREAKER_THRESHOLD=1
# Active health checks: each upstream's route healthPath (default /health) is polled this often; a failure
# opens its breaker before a client request reaches it, a pass closes it again. 0 turns them off.
UPSTREAM_HEALTH_INTERVAL_MS=5000

# --- /metrics bearer token (>= 32 chars). Empty disables the endpoint. Generate: openssl rand -hex 32
METRICS_TOKEN=

# --- Service keys referenced by routes.json "injectApiKey" (one key per service, dedicated to the gateway)
AUTH_API_KEY=REPLACE_WITH_THE_GATEWAY_KEY_FROM_AUTH_API_KEYS
MEDIA_API_KEY=REPLACE_WITH_THE_GATEWAY_KEY_FROM_MEDIA_API_KEYS
NOTIFY_API_KEY=REPLACE_WITH_THE_GATEWAY_KEY_FROM_NOTIFY_API_KEYS
# Read-role key for the public content-bundles route: CONTENT_API_KEYS=atc-gateway:…:read
CONTENT_API_KEY=

# --- Central rate limit policies (optional): routes with "policy" check the ratelimit service. Both or neither. A check-role key: RATELIMIT_API_KEYS=atc-gateway:…:check
RATELIMIT_URL=
RATELIMIT_API_KEY=
RATELIMIT_TIMEOUT_MS=300

# --- Audit trail of refusals (optional): 401, 413 and rate-limit 429 answers and route reloads go to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-gateway:…:write
AUDIT_URL=
AUDIT_API_KEY=
# Refusals are sampled: one event per route, reason and client IP per window (the next one says how many were left out). 0 = every refusal.
AUDIT_SAMPLE_SEC=10

# --- Geo headers (optional): routes with "geo": true get X-Geo-Country/-Timezone/-Continent from the geo service. Both or neither. A read-role key.
GEO_URL=
GEO_API_KEY=
GEO_TIMEOUT_MS=300
GEO_CACHE_SEC=600
